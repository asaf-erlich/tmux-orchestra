#!/bin/sh
set -eu

ORCHESTRA_LIB=$(CDPATH='' cd -- "$(dirname -- "$0")/../lib" && pwd)
# shellcheck disable=SC1091
. "$ORCHESTRA_LIB/common.sh"

# Usage: orchestra-follow WINDOW_ID PANE_ID
#
# There is one sidebar per server (global option @orchestra_sidebar_pane_id).
# The pane-focus-in and client-session-changed hooks pass the window and pane
# that received focus, in whatever session, and the sidebar moves there:
# move-pane works across sessions, so switching sessions brings the sidebar
# along.
#
# The hooks pass explicit ids because an untargeted display-message inside a
# hook's run-shell resolves against whichever client tmux considers current,
# which can be a window the user is not looking at. Following that window
# runs select-pane there, which fires pane-focus-in again and can loop.
if [ $# -ge 2 ]; then
    current_window=$1
    target_pane=$2
else
    current_window=$(tmux display-message -p '#{window_id}' 2>/dev/null) || exit 0
    target_pane=
fi
[ -n "$current_window" ] || exit 0

# One call for the global sidebar options (formats resolve global options).
opts=$(tmux display-message -p -t "$current_window" '#{@orchestra_sidebar_pane_id}|#{@orchestra_sidebar_width}|#{@orchestra_width}' 2>/dev/null) || exit 0
sidebar_pane=${opts%%|*}
opts=${opts#*|}
width=${opts%%|*}
[ -n "$width" ] || width=${opts#*|}
[ -n "$sidebar_pane" ] || exit 0

# Which window currently hosts the sidebar? If the pane is gone (killed by
# hand, its window closed), forget it so toggle opens a fresh one.
# The same call reads the window's layout and the layouts saved when the
# sidebar entered it (sidebar_layout_restore in lib/common.sh).
old_layout=$(tmux display-message -p -t "$sidebar_pane" "$SIDEBAR_LAYOUT_FORMAT" 2>/dev/null) || old_layout=''
sidebar_window=${old_layout%%|*}
if [ -z "$sidebar_window" ]; then
    tmux set-option -gqu @orchestra_sidebar_pane_id \; set-option -gqu @orchestra_sidebar_pid >/dev/null 2>&1 || true
    exit 0
fi

# Already here — nothing to do. This also ends the chain started by our own
# select-pane below, whose pane-focus-in lands in the window we moved into.
[ "$sidebar_window" != "$current_window" ] || exit 0

# Never try to move the sidebar next to itself.
[ "$target_pane" != "$sidebar_pane" ] || exit 0

# Fall back to the active pane in the current window. The hook's pane can
# also be stale: select-window fires pane-focus-in for the window's previous
# active pane, and a select-pane in the same command (a sidebar click or
# Enter on another pane of that window) has already moved focus on by the
# time this runs. Selecting the stale pane would undo that pick.
active_info=$(tmux display-message -p -t "$current_window" '#{pane_id}|#{window_layout}' 2>/dev/null) || exit 0
active_pane=${active_info%%|*}
layout_before=${active_info#*|}
if [ -z "$target_pane" ] || [ "$(tmux display-message -p -t "$target_pane" '#{pane_active}' 2>/dev/null)" != 1 ]; then
    target_pane=$active_pane
fi
[ -n "$target_pane" ] || exit 0

# The focused pane must still belong to the window we are following.
target_window=$(tmux display-message -p -t "$target_pane" '#{window_id}' 2>/dev/null) || exit 0
[ "$target_window" = "$current_window" ] || exit 0

case "$width" in
    ''|*[!0-9]*) width=32 ;;
esac

# Move the sidebar pane to the left edge of the current window, full height
# (-f), whichever pane is focused.
# If the source window contained only this pane, tmux closes that window.
tmux move-pane -dfhb -l "$width" -s "$sidebar_pane" -t "$target_pane" >/dev/null 2>&1 || exit 0

# Give the old window back the layout it had before the sidebar came, and
# remember this one's, so visits do not shift width between its panes.
sidebar_layout_restore "$old_layout"
sidebar_layout_save "$current_window" "$layout_before"

# Return focus to the main content pane, not the sidebar. move-pane -d leaves
# the active pane alone, so only select when needed; every select-pane is
# another pane-focus-in event.
active=$(tmux display-message -p -t "$target_pane" '#{pane_active}' 2>/dev/null || true)
if [ "$active" != 1 ]; then
    tmux select-pane -t "$target_pane" >/dev/null 2>&1 || true
fi
