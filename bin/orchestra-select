#!/bin/sh
# Keyboard selection in the sidebar.
# Usage: orchestra-select <up|down|enter|reset> <session>
#
# The selection is stored as a window_id in the session option
# @ab_selected_window so it survives window reordering. An unset or stale
# value means "the active window". up/down move it (clamped at the ends)
# without switching windows; enter runs select-window on it, the same effect
# as a click; reset clears it. The sidebar's key reader does not run this: it
# sources lib/select.sh directly.
set -eu

ORCHESTRA_LIB=$(CDPATH='' cd -- "$(dirname -- "$0")/../lib" && pwd)
# shellcheck disable=SC1091
. "$ORCHESTRA_LIB/select.sh"

usage() {
    printf '%s\n' "$1" >&2
    exit 1
}

[ $# -eq 2 ] || usage 'usage: orchestra-select <up|down|enter|reset> <session>'
session=$2

case "$1" in
    reset) select_reset "$session" ;;
    up) select_move "$session" -1 || exit 0 ;;
    down) select_move "$session" 1 || exit 0 ;;
    enter) select_move "$session" 0 enter || exit 0 ;;
    *) usage "unknown action: $1" ;;
esac

if [ -n "$SELECT_SIDEBAR_PID" ]; then
    kill -USR1 "$SELECT_SIDEBAR_PID" 2>/dev/null || true
fi
