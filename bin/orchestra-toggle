#!/bin/sh
set -eu

ORCHESTRA_LIB=$(CDPATH='' cd -- "$(dirname -- "$0")/../lib" && pwd)
# shellcheck disable=SC1091
. "$ORCHESTRA_LIB/common.sh"

# There is one sidebar per server, recorded in global options
# (@orchestra_sidebar_pane_id, @orchestra_sidebar_pid, @orchestra_sidebar_width)
# so orchestra-follow can move it across sessions. Toggle closes it wherever
# it is, or opens it in the current window.
plugin_dir=$(ab_plugin_dir)
current_window=$(resolve_window '')

sidebar_pane=$(tmux show-options -gqv @orchestra_sidebar_pane_id 2>/dev/null || true)
if [ -n "$sidebar_pane" ] && pane_exists "$sidebar_pane"; then
    tmux kill-pane -t "$sidebar_pane" >/dev/null 2>&1 || ab_tmux_fail 'failed to close sidebar'
    tmux set-option -gqu @orchestra_sidebar_pane_id \; set-option -gqu @orchestra_sidebar_pid >/dev/null 2>&1 || ab_tmux_fail 'failed to clear sidebar options'
    exit 0
fi

width=$(tmux show-options -gqv @orchestra_sidebar_width 2>/dev/null || true)
if [ -z "$width" ]; then
    width=$(tmux show-options -gvq @orchestra_width 2>/dev/null || printf '32')
fi
case "$width" in
    ''|*[!0-9]*) width=32 ;;
esac

pane_info=$(tmux split-window -bfhd -l "$width" -t "$current_window" -c "$PWD" -P -F '#{pane_id}|#{pane_pid}' "exec \"$plugin_dir/bin/orchestra-render\"") || ab_tmux_fail 'failed to open sidebar'
new_pane=${pane_info%%|*}
new_pid=${pane_info#*|}

tmux set-option -pt "$new_pane" pane-border-status off >/dev/null 2>&1 || true

tmux set-option -gq @orchestra_sidebar_pane_id "$new_pane" \; \
    set-option -gq @orchestra_sidebar_pid "$new_pid" \; \
    set-option -gq @orchestra_sidebar_width "$width" >/dev/null 2>&1 || ab_tmux_fail 'failed to store sidebar options'
