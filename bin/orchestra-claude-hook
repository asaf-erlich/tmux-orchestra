#!/bin/sh
# Claude Code hook dispatcher: maps Claude Code hook events (JSON on stdin)
# onto orchestra state. Wire each event in ~/.claude/settings.json as
# `orchestra-claude-hook <event>`; see hooks/claude-code/README.md.
#
#   prompt         UserPromptSubmit: store the prompt, mark running
#   pre-tool       PreToolUse: mark running with a readable tool summary
#   post-tool      PostToolUse: a tool ran, so a permission prompt for it was
#                  approved: waiting goes back to running
#   tool-failure   PostToolUseFailure: an interrupt (Esc, or rejecting a
#                  permission prompt) ends the turn without a Stop: clear
#                  state; any other failure is like post-tool
#   permission-denied
#                  PermissionDenied: a rejected tool call; clear state (if
#                  Claude carries on, its next hook marks running again)
#   notification   Notification: permission prompts and questions mark the
#                  pane waiting; the idle reminder Claude sends a minute
#                  after a turn ends does not (the turn is over, not blocked)
#   stop           Stop: done, finish time, unread unless you are looking;
#                  "background" instead while background tasks (agents,
#                  shells, monitors) are still running
#   stop-failure   StopFailure: the turn ended on an API error (rate limit,
#                  overload, ...): error
#   pre-compact    PreCompact: compacting
#   post-compact   PostCompact: back to running after an automatic compaction,
#                  idle after /compact
#   session-start  SessionStart: /clear and fresh starts leave an empty
#                  session marker; resume restores the last prompt; every
#                  start (and prompt) records the session id in
#                  @ab_session_id for bin/orchestra-resurrect
#   session-end    SessionEnd: clear state
#   reconcile      Not a hook; bin/orchestra-render runs it with the
#                  background refresh. Clears running/waiting on each Claude
#                  pane whose own session reports idle: rejecting a
#                  permission prompt or pressing Esc ends the turn with no
#                  hook at all. Also checks the health of an idle session's
#                  "background" work (the task ids Stop counted are in
#                  @ab_bg_tasks): ends it once the transcript shows every
#                  task finished, or once its processes and output files show
#                  nothing working for 10 minutes; "background?" when that
#                  cannot be told.
#   backfill       Not a hook. Fill prompt, finish time and empty-session
#                  marker for Claude panes already running, from
#                  ~/.claude/sessions/<pid>.json and the session transcript.
#
# State is written as pane options on the Claude pane ($TMUX_PANE, through
# `orchestra --pane`), so several Claude sessions in one window keep their
# own rows; without $TMUX_PANE (a session the Claude daemon hosts) it falls
# back to the window. Session start and each prompt give the pane empty values
# that hide what is on its window, which every pane would otherwise inherit.
#
# Requires jq. Always exits 0 so a hook never blocks Claude.

BIN_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1091
. "$BIN_DIR/../lib/common.sh"
# shellcheck disable=SC1091
. "$BIN_DIR/../lib/select.sh"

CLAUDE_DIR=${CLAUDE_CONFIG_DIR:-$HOME/.claude}

orchestra() {
    "$BIN_DIR/orchestra" "$@" >/dev/null 2>&1
}

field() {
    printf '%s' "$input" | jq -r "$1 // empty" 2>/dev/null
}

mtime() {
    date -r "$1" +%s 2>/dev/null || stat -c %Y "$1" 2>/dev/null
}

# Remember which Claude session this pane runs (@ab_session_id), so
# `orchestra-resurrect save` can write it down and, after a tmux server
# restart, the sidebar can offer to resume it. Kept out of AB_AGENT_OPTS:
# clear-state must not forget it. Pane scope only: a window has no one
# session.
record_session_id() {
    [ "$scope" = '--pane' ] || return 0
    sid=$(field .session_id)
    [ -z "$sid" ] || set_opt "$target" '@ab_session_id' "$sid"
}

event_prompt() {
    migrate_window
    record_session_id
    prompt=$(field .prompt)
    # Claude Code submits background-task results as a prompt wrapped in
    # tags (<task-notification>...); keep the last prompt you typed.
    case "$prompt" in
        '<'*) ;;
        *) orchestra set-prompt "$prompt" "$scope" "$target" ;;
    esac
    clear_opt "$target" '@ab_session_source'
    clear_opt "$target" '@ab_bg_tasks'
    clear_opt "$target" '@ab_bg_alive_at'
    orchestra set-state running --spinner claude --action thinking "$scope" "$target"
}

event_pre_tool() {
    action=$(field '.tool_name + ": " + ((.tool_input.description // .tool_input.command
        // .tool_input.file_path // .tool_input.pattern // .tool_input.url
        // .tool_input.prompt // (.tool_input | tostring)) | tostring
        | gsub("\\s+"; " ") | .[0:100])')
    orchestra set-state running --spinner claude --action "${action:-working}" "$scope" "$target"
}

# Back to running after an approved permission prompt; any other state is
# left alone (a later PreToolUse or Stop moves it on).
event_post_tool() {
    [ "$(get_opt "$target" '@ab_agent_state')" = 'waiting' ] || return 0
    orchestra set-state running --spinner claude --action "$(field .tool_name): done" "$scope" "$target"
}

# No Stop hook runs after an interrupt, so without this the window would
# keep showing the last state (red, after rejecting a permission prompt).
event_turn_aborted() {
    orchestra clear-state "$scope" "$target"
}

# True when an attached client is showing the target: its window is the
# session's active window and, for a pane, it is that window's active pane.
looking() {
    [ "$(tmux display-message -p -t "$target" '#{&&:#{window_active},#{&&:#{session_attached},#{pane_active}}}' 2>/dev/null)" = 1 ]
}

# State lives on the Claude pane, and pane options win over window options,
# but a pane without a value of its own shows its window's: hide whatever
# window-scoped state is there (an earlier version, or another Claude session
# in the window whose hooks have no $TMUX_PANE, like `claude attach`) when a
# session starts or a turn begins.
migrate_window() {
    [ "$scope" = '--pane' ] || return 0
    shadow_pane_agent_opts "$target"
}

event_notification() {
    kind=$(field .notification_type)
    message=$(field .message)
    case "$kind" in
        idle_prompt) return 0 ;;
        permission_prompt)
            # The pending tool call PreToolUse just recorded says more than
            # "Claude needs your permission to use Bash".
            pending=$(get_opt "$target" '@ab_current_action')
            [ "$pending" = 'thinking' ] && pending=''
            orchestra set-state waiting --spinner claude --action "allow? ${pending:-$message}" "$scope" "$target"
            ;;
        *)
            orchestra set-state waiting --spinner claude --action "${message:-needs input}" "$scope" "$target"
            ;;
    esac
    # Unread means "needs you while you were elsewhere": skip it for the
    # pane an attached client is showing.
    looking || orchestra notify --quiet --title 'Claude Code' --body "${message:-needs input}" "$scope" "$target"
}

# Stop lists the session's background tasks; finished ones may linger in
# the list. An idle agent is not doing work either. Agent-team teammates
# ("type": "teammate") are skipped whatever their status: Claude Code
# reports one as "running" for its whole life, including while it sits
# idle waiting to be messaged, and a teammate that does message back starts
# a new turn anyway (UserPromptSubmit marks running again).
# shellcheck disable=SC2016 # jq program, not shell.
RUNNING_TASKS='[.background_tasks[]? | select(.type != "teammate")
    | select((.status // "running") as $s
    | ["completed", "failed", "killed", "cancelled", "canceled", "stopped", "done", "error", "idle"]
    | index($s) | not)]'

# Prints "N background: <first description>" or nothing.
background_summary() {
    # shellcheck disable=SC2016 # jq program, not shell.
    field "$RUNNING_TASKS"'
        | if length == 0 then empty
          else "\(length) background: \(.[0].description // .[0].command // .[0].type // "task")"
          end | gsub("\\s+"; " ")'
}

# The ids of those tasks, space-separated. Stop is the only hook that lists
# them, so it records them (@ab_bg_tasks) for reconcile to check later.
background_task_ids() {
    field "$RUNNING_TASKS"' | map(.id // .task_id // empty | tostring) | join(" ")' |
        tr -cd 'A-Za-z0-9_ -'
}

event_stop() {
    # Background work still running: Claude picks the turn up again when it
    # finishes, so this is not "finished" yet.
    pending=$(background_summary)
    if [ -n "$pending" ]; then
        orchestra set-state background --spinner claude --action "$pending" "$scope" "$target"
        set_opt "$target" '@ab_bg_tasks' "$(background_task_ids)"
        # Stop just saw them running: the health check counts from here.
        set_opt "$target" '@ab_bg_alive_at' "$(date +%s)"
        return 0
    fi
    clear_opt "$target" '@ab_bg_tasks'
    clear_opt "$target" '@ab_bg_alive_at'
    orchestra set-state 'done' "$scope" "$target"
    orchestra clear-state "$scope" "$target"
    # Unread means "finished while you were elsewhere": skip it for the
    # pane an attached client is showing.
    looking || orchestra notify --quiet --title 'Claude Code' --body 'finished' "$scope" "$target"
}

event_stop_failure() {
    error=$(field .error)
    orchestra set-state error --spinner claude --action "error: ${error:-unknown}" "$scope" "$target"
    looking || orchestra notify --quiet --title 'Claude Code' --body "stopped: ${error:-error}" "$scope" "$target"
}

event_pre_compact() {
    trigger=$(field .trigger)
    orchestra set-state compacting --spinner claude --action "compacting${trigger:+ ($trigger)}" "$scope" "$target"
}

event_post_compact() {
    if [ "$(field .trigger)" = 'manual' ]; then
        orchestra clear-state "$scope" "$target"
    else
        orchestra set-state running --spinner claude --action 'compacted' "$scope" "$target"
    fi
}

event_session_start() {
    source=$(field .source)
    [ "$source" = 'compact' ] && return 0
    migrate_window
    record_session_id
    # A session started here, by hand or by the sidebar's resume: whatever
    # was waiting to be resumed is no longer.
    clear_opt "$target" '@ab_resume_id'
    orchestra clear-state "$scope" "$target"
    case "$source" in
        clear|startup)
            orchestra set-prompt '' "$scope" "$target"
            # Age a fresh session from its start. Without its own stamp a
            # pane falls back to the window's activity, which every other
            # pane in the window keeps at "now".
            set_opt "$target" '@ab_finished_at' "$(date +%s)"
            clear_opt "$target" '@ab_last_notification'
            set_opt "$target" '@ab_session_source' "$source"
            ;;
        *)
            prompt=$(last_prompt "$(field .transcript_path)")
            orchestra set-prompt "$prompt" "$scope" "$target"
            clear_opt "$target" '@ab_session_source'
            ;;
    esac
}

# Claude's pid for a pane: the pane process itself or one of its children.
claude_session_file() {
    for pid in "$1" $(pgrep -P "$1" 2>/dev/null); do
        [ -r "$CLAUDE_DIR/sessions/$pid.json" ] && { printf '%s\n' "$CLAUDE_DIR/sessions/$pid.json"; return 0; }
    done
    return 1
}

backfill() {
    tmux list-panes -a -F "#{pane_id}|#{pane_pid}|$ORCHESTRA_CLAUDE_PANE|#{@ab_agent_state}" 2>/dev/null |
    while IFS='|' read -r pane pane_pid is_claude state; do
        [ "$is_claude" = 1 ] || continue
        if session_file=$(claude_session_file "$pane_pid"); then
            # Window-scoped state would show through on a pane with a session.
            shadow_pane_agent_opts "$pane"
        else
            # `claude agents` (the background-agent manager) has no session.
            case " $(ps -o command= -p "$pane_pid" 2>/dev/null) $(pgrep -lfP "$pane_pid" 2>/dev/null) " in
                *' agents '*)
                    set_opt "$pane" '@ab_session_source' 'agents'
                    clear_opt "$pane" '@ab_last_prompt'
                    clear_opt "$pane" '@ab_last_notification'
                    printf '%s (agents view)\n' "$pane"
                    ;;
            esac
            continue
        fi
        sid=$(jq -r '.sessionId // empty' "$session_file" 2>/dev/null)
        status=$(jq -r '.status // empty' "$session_file" 2>/dev/null)
        [ -n "$sid" ] || continue
        transcript=$(find "$CLAUDE_DIR/projects" -maxdepth 2 -name "$sid.jsonl" 2>/dev/null | head -n 1)
        prompt=''
        [ -n "$transcript" ] && prompt=$(last_prompt "$transcript")
        if [ -n "$prompt" ]; then
            set_opt "$pane" '@ab_last_prompt' "$prompt"
            clear_opt "$pane" '@ab_session_source'
        else
            clear_opt "$pane" '@ab_last_prompt'
            set_opt "$pane" '@ab_session_source' 'empty'
        fi
        [ "$status" = 'idle' ] || continue
        # Idle: any state left is stale (the idle reminder's "waiting", a
        # "running" whose Stop hook predates this script); the transcript's
        # last write is when the turn ended.
        if [ -n "$state" ]; then
            clear_opt "$pane" '@ab_agent_state'
            clear_opt "$pane" '@ab_current_action'
            clear_opt "$pane" '@ab_spinner'
        fi
        case "$(get_opt "$pane" '@ab_last_notification')" in
            *'waiting for input'*) clear_opt "$pane" '@ab_last_notification' ;;
        esac
        if [ -n "$transcript" ] && [ -n "$prompt" ]; then
            finished=$(mtime "$transcript")
            [ -n "$finished" ] && set_opt "$pane" '@ab_finished_at' "$finished"
        fi
        printf '%s %s\n' "$pane" "${prompt:-(empty session)}" | cut -c 1-100
    done
}

# Usage: bg_end TARGET SCOPE
# The background work is over: end as Stop does for a finished turn.
bg_end() {
    clear_opt "$1" '@ab_bg_tasks'
    clear_opt "$1" '@ab_bg_alive_at'
    orchestra set-state 'done' "$2" "$1"
    orchestra clear-state "$2" "$1"
    looking || orchestra notify --quiet --title 'Claude Code' --body 'finished' "$2" "$1"
}

# Seconds with no sign of work before an all-stopped pane ends, and the age
# under which a task output file still counts as being written.
BG_GRACE=${ORCHESTRA_BG_GRACE:-600}
BG_FRESH=${ORCHESTRA_BG_FRESH:-120}
TASKS_ROOT=${ORCHESTRA_TASKS_ROOT:-/private/tmp/claude-$(id -u)}

# Usage: bg_procs_alive CLAUDE_PID IDS
# True when a descendant of claude in $PS_SNAPSHOT ("pid ppid command" lines,
# one `ps` for every pane) runs background work: a shell command (a
# background shell, an agent's tool call, a foreground build all run as
# `sh -c` children) or anything naming a recorded task's output file. Claude's
# own helpers (MCP servers, caffeinate) do not count.
bg_procs_alive() {
    printf '%s\n' "$PS_SNAPSHOT" | awk -v root="$1" -v ids="$2" '
        { par[$1] = $2; c = $0; sub(/^ *[0-9]+ +[0-9]+ */, "", c); cmd[$1] = c }
        END {
            n = split(ids, want, " ")
            for (p in par) {
                q = p
                for (d = 0; d < 8 && q != "" && q != root; d++) q = par[q]
                if (q != root || p == root) continue
                if (cmd[p] ~ /^(\/usr\/bin\/|\/bin\/)?(zsh|bash|sh) -c /) exit 0
                for (i = 1; i <= n; i++) if (index(cmd[p], "/" want[i] ".output")) exit 0
            }
            exit 1
        }'
}

# Usage: bg_mark TARGET on|off
# "N background: cmd" reads "N background? cmd" while the work's health cannot
# be told (the sidebar greys it).
bg_mark() {
    act=$(get_opt "$1" '@ab_current_action')
    case "$2:$act" in
        on:[0-9]*' background: '*) set_opt "$1" '@ab_current_action' "${act%% background: *} background? ${act#* background: }" ;;
        off:[0-9]*' background? '*) set_opt "$1" '@ab_current_action' "${act%% background? *} background: ${act#* background? }" ;;
    esac
}

# Usage: bg_check TARGET SCOPE SESSION_FILE SESSION_ID IDS IDLE_SINCE_MS
# Health of an idle session's background work. Alive when a process or a
# fresh task output file says so (recorded in @ab_bg_alive_at); unknown when a
# task leaves neither (an in-process watcher or monitor): the pane stays
# background, marked "background?". Only when every task is known to have
# stopped, and BG_GRACE seconds have passed since it was last seen working
# (else since the session went idle), does the pane end.
bg_check() {
    now_s=$((now_ms / 1000))
    alive=''
    unknown=''
    pid=$(jq -r '.pid // empty' "$3" 2>/dev/null)
    if [ -n "$pid" ] && bg_procs_alive "$pid" "$5"; then
        alive=1
    fi
    for id in $5; do
        out=''
        for f in "$TASKS_ROOT"/*/"$4"/tasks/"$id".output; do
            [ -f "$f" ] && out=$f
        done
        if [ -z "$out" ]; then
            unknown=1
            continue
        fi
        written=$(mtime "$out")
        case "$written" in ''|*[!0-9]*) alive=1; continue ;; esac
        [ $((now_s - written)) -lt "$BG_FRESH" ] && alive=1
    done
    if [ -n "$alive" ]; then
        set_opt "$1" '@ab_bg_alive_at' "$now_s"
        bg_mark "$1" off
    elif [ -n "$unknown" ]; then
        bg_mark "$1" on
    else
        seen=$(get_opt "$1" '@ab_bg_alive_at')
        case "$seen" in ''|*[!0-9]*) seen=$(($6 / 1000)) ;; esac
        [ $((now_s - seen)) -ge "$BG_GRACE" ] && bg_end "$1" "$2"
    fi
    return 0
}

# Usage: reconcile_background PANE WINDOW SESSION_FILE IDLE_SINCE_MS
# An idle session in the background state: Stop recorded the tasks it saw
# running (@ab_bg_tasks). Claude Code starts a new turn (and so a new Stop)
# when one finishes, but a task that finished during the Stop turn itself, or
# was killed, never does, and the pane would show background for good. When
# the transcript holds a finished <task-notification> for every recorded
# task, the work is over: end as Stop does for a finished turn. Otherwise
# bg_check looks at the processes and output files.
reconcile_background() {
    if [ -n "$(get_opt "$1" '@ab_agent_state')" ]; then
        target=$1
        scope=--pane
    else
        target=$2
        scope=--window
    fi
    ids=$(get_opt "$target" '@ab_bg_tasks')
    [ -n "$ids" ] || return 0
    sid=$(jq -r '.sessionId // empty' "$3" 2>/dev/null)
    [ -n "$sid" ] || return 0
    transcript=$(find "$CLAUDE_DIR/projects" -maxdepth 2 -name "$sid.jsonl" 2>/dev/null | head -n 1)
    notified=1
    [ -n "$transcript" ] || notified=''
    for id in $ids; do
        [ -n "$notified" ] || break
        # The task's latest notification decides (an agent can be resumed).
        last=$(grep -F "<task-id>$id</task-id>" "$transcript" 2>/dev/null | tail -n 1)
        case "$last" in
            *'<status>completed</status>'*|*'<status>failed</status>'*|*'<status>killed</status>'*|*'<status>stopped</status>'*) ;;
            *) notified='' ;;
        esac
    done
    if [ -n "$notified" ]; then
        bg_end "$target" "$scope"
        return 0
    fi
    bg_check "$target" "$scope" "$3" "$sid" "$ids" "$4"
}

# Usage: reconcile_pane PANE WINDOW STATE SESSION_FILE
# STATE is the pane's own state, or its window's when it has none.
reconcile_pane() {
    case "$3" in running|waiting|background) ;; *) return 0 ;; esac
    idle_since=$(jq -r 'select(.status == "idle") | .statusUpdatedAt // empty' "$4" 2>/dev/null)
    case "$idle_since" in
        ''|*[!0-9]*) return 0 ;;
    esac
    [ $((now_ms - idle_since)) -ge 3000 ] || return 0
    [ "$3" != background ] || { reconcile_background "$1" "$2" "$4" "$idle_since"; return 0; }
    if [ -n "$(get_opt "$1" '@ab_agent_state')" ]; then
        orchestra clear-state --pane "$1"
        clear_opt "$1" '@ab_unread'
    else
        orchestra clear-state --window "$2"
        clear_opt "$2" '@ab_unread'
    fi
    # Rejecting the prompt or pressing Esc means you were at the pane:
    # the unread its permission notification left is dropped above, or
    # the pane would read "finished, not yet seen".
}

# Claude keeps its own status (busy, waiting, idle) in its session file.
# Only a status that has been idle for a few seconds counts, so a hook that
# just marked a new turn running is not undone before Claude reports busy.
reconcile() {
    command -v jq >/dev/null 2>&1 || return 0
    now_ms=$(($(date +%s) * 1000))
    # Each Claude pane has its own session file and its own state. A pane
    # with no state of its own shows its window's (an earlier version, or a
    # window-scoped `orchestra set-state`); that is cleared on the window.
    panes=$(tmux list-panes -a -F "#{pane_id}|#{window_id}|#{pane_pid}|$ORCHESTRA_CLAUDE_PANE|#{@ab_agent_state}" 2>/dev/null)
    # One ps serves every background pane's health check; none without one.
    PS_SNAPSHOT=''
    case "$panes" in
        *'|background'*) PS_SNAPSHOT=$(ps -axo pid=,ppid=,command= 2>/dev/null) ;;
    esac
    printf '%s\n' "$panes" |
    while IFS='|' read -r pane window pane_pid is_claude state; do
        [ "$is_claude" = 1 ] || continue
        session_file=$(claude_session_file "$pane_pid") || continue
        reconcile_pane "$pane" "$window" "$state" "$session_file"
        # A pane with its own session never shows window-scoped state (a
        # daemon-hosted session in the window, or an earlier version's).
        shadow_pane_agent_opts "$pane"
    done
}

event=${1-}
case "$event" in
    backfill) backfill; exit 0 ;;
    reconcile) reconcile; exit 0 ;;
esac

input=$(cat)
command -v jq >/dev/null 2>&1 || exit 0
# State goes on the Claude pane, so two Claude sessions split in one window
# keep their own rows; without a pane (not run by Claude in tmux), the
# window as before.
if [ -n "${TMUX_PANE:-}" ] && pane_exists "$TMUX_PANE"; then
    target=$TMUX_PANE
    scope=--pane
else
    target=$(resolve_window '' 2>/dev/null) || exit 0
    scope=--window
fi
[ -n "$target" ] || exit 0

case "$event" in
    prompt) event_prompt ;;
    pre-tool) event_pre_tool ;;
    notification) event_notification ;;
    post-tool) event_post_tool ;;
    tool-failure)
        if [ "$(field .is_interrupt)" = 'true' ]; then event_turn_aborted; else event_post_tool; fi ;;
    permission-denied) event_turn_aborted ;;
    stop) event_stop ;;
    stop-failure) event_stop_failure ;;
    pre-compact) event_pre_compact ;;
    post-compact) event_post_compact ;;
    session-start) event_session_start ;;
    session-end) orchestra clear-state "$scope" "$target" ;;
esac
exit 0
