#!/bin/sh
set -eu

ORCHESTRA_LIB=$(CDPATH='' cd -- "$(dirname -- "$0")/../lib" && pwd)
# shellcheck disable=SC1091
. "$ORCHESTRA_LIB/render.sh"
# shellcheck disable=SC1091
. "$ORCHESTRA_LIB/select.sh"

# Process creation can be very slow (endpoint security scans every exec), so
# a tick costs exactly one tmux call and one awk, and a keypress burst two
# tmux calls in the reader plus the redraw it triggers.

# The reader sends SIGUSR1 after a key and hooks send it after state
# changes. A signal that arrives while redraw is running would otherwise be
# absorbed and the next full sleep would delay the update, so remember it.
nudged=0
trap 'nudged=1' USR1

sleep_interruptible() {
    [ "$nudged" = 0 ] || return 0
    sleep "$1" &
    sleep_pid=$!
    wait "$sleep_pid" 2>/dev/null || true
    kill "$sleep_pid" 2>/dev/null || true
    # Reap the killed sleep here, with stderr silenced. Otherwise bash (macOS
    # /bin/sh) reports "Terminated: 15 sleep" on the pane's tty the next time
    # it checks job status, and the message flashes in the sidebar until the
    # next redraw.
    wait "$sleep_pid" 2>/dev/null || true
}

redraw() {
    # One tmux call: the sidebar pane's own width (tput cols inside $(...)
    # sees no terminal and reports 80) and the two global options, then one
    # line per window. Fields 18-19 carry @ab_selected_window and whether the
    # sidebar has focus (active window whose active pane is the sidebar).
    if frame_dump=$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#{pane_width}|#{@orchestra_nerd_fonts}|#{@orchestra_wait_color}' \; \
        list-windows ${TMUX_PANE:+-t "$TMUX_PANE"} -F '#{session_name}|#{window_id}|#{window_name}|#{window_active}|#{@ab_agent_state}|#{@ab_current_action}|#{@ab_branch}|#{@ab_cwd}|#{@ab_last_cmd}|#{@ab_progress}|#{@ab_progress_label}|#{@ab_unread}|#{@ab_last_notification}|#{@ab_status_phase}|#{@ab_status_phase__icon}|#{@ab_status_phase__color}|#{@ab_spinner}|#{@ab_selected_window}|#{&&:#{window_active},#{==:#{pane_id},#{@ab_sidebar_pane_id}}}' 2>/dev/null); then
        :
    else
        frame_dump=''
    fi

    printf '\033[H'
    printf '%s\n' "$frame_dump" | render_frame "${FRAME_INDEX:-0}"
    printf '\033[J'
}

# Keyboard selection. A background reader blocks on the tty (no work while
# idle), folds every key in one read into a net movement, applies it with
# select_move (lib/select.sh) and nudges this process with SIGUSR1. The mouse
# wheel arrives as cursor keys once the alternate screen is active, so it
# moves the selection too.
handle_keys() {
    renderer_pid=$1
    esc=$(printf '\033')
    cr=$(printf '\r')
    nl='
'
    # The sidebar moves between windows but never leaves its session.
    session=''
    while :; do
        # min 1 time 0: dd returns as soon as input is available, with every
        # byte queued so far (keys pile up while an update runs). The x keeps
        # $(...) from eating a trailing newline (Enter).
        keys=$(dd bs=1024 count=1 2>/dev/null; printf x) || break
        keys=${keys%x}
        [ -n "$keys" ] || break
        kill -0 "$renderer_pid" 2>/dev/null || break

        delta=0
        while [ -n "$keys" ]; do
            case "$keys" in
                "$esc"[[O]?*)
                    case "$keys" in
                        "$esc"?A*) delta=$((delta - 1)) ;;
                        "$esc"?B*) delta=$((delta + 1)) ;;
                    esac
                    rest=${keys#???}
                    ;;
                k*) delta=$((delta - 1)); rest=${keys#?} ;;
                j*) delta=$((delta + 1)); rest=${keys#?} ;;
                "$cr"* | "$nl"*)
                    apply_selection "$delta" enter
                    delta=0
                    rest=${keys#?}
                    ;;
                *) rest=${keys#?} ;;
            esac
            # A byte the shell cannot match as a character: drop the rest.
            [ "$rest" != "$keys" ] || break
            keys=$rest
        done
        [ "$delta" -eq 0 ] || apply_selection "$delta"
    done
}

apply_selection() {
    if [ -z "$session" ]; then
        session=$(tmux display-message -p -t "${TMUX_PANE:-}" '#{session_id}' 2>/dev/null) || session=''
    fi
    [ -n "$session" ] || return 0
    if ! select_move "$session" "$@"; then
        # Stale cache (session renamed away or gone): resolve once more.
        session=$(tmux display-message -p -t "${TMUX_PANE:-}" '#{session_id}' 2>/dev/null) || session=''
        [ -n "$session" ] || return 0
        select_move "$session" "$@" || return 0
    fi
    kill -USR1 "$renderer_pid" 2>/dev/null || true
}

stty_saved=''
reader_pid=''
if [ -t 0 ]; then
    stty_saved=$(stty -g 2>/dev/null) || stty_saved=''
    # -echo also stops unhandled keys from walking the cursor around.
    stty -echo -icanon min 1 time 0 2>/dev/null || true
    # Asynchronous lists get stdin from /dev/null unless redirected explicitly.
    exec 3<&0
    handle_keys "$$" <&3 &
    reader_pid=$!
    exec 3<&-
fi

restore() {
    if [ -n "$reader_pid" ]; then
        kill "$reader_pid" 2>/dev/null || true
    fi
    printf '\033[?25h\033[?1049l'
    if [ -n "$stty_saved" ]; then
        stty "$stty_saved" 2>/dev/null || true
    fi
}

trap restore EXIT
printf '\033[?1049h\033[?25l'

FRAME_INDEX=0
while true; do
    nudged=0
    redraw
    FRAME_INDEX=$((FRAME_INDEX + 1))
    sleep_interruptible 0.125
done
